# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# Real PJP data pulled from IRA_FIXTURES_DIR -- never commit (see ground rules)
/golden-values.json
# Root-level data workbooks, e.g. the LTDBB transaction file scripts/import-ltdbb.ts reads by default
/*.xlsx
# TIKMI templates embed a filled PJP sample (KK) and BI data for every PJP (Sumber BI sheets).
# Kept out of git until it is decided which parts may be committed (docs/tikmi-plan.md, open questions).
/templates/tikmi/**/*.xlsx
/templates/tikmi/**/_dump/
/templates/tikmi/**/_parity/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local development file store (apps/web/lib/fileStorage.ts without Supabase)
/.tikmi-files/
