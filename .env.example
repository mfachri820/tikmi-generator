# Postgres. Local: docker compose up -d postgres (host port 5435).
DATABASE_URL=postgres://tikmi:tikmi@localhost:5435/tikmi

# Shared secret between the app and the Google Form's Apps Script (apps-script/README.md). A long random string.
FORM_INGEST_SECRET=

# Private file storage (Supabase Storage). Leave empty locally: files then go to .tikmi-files/ in the repo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TIKMI_STORAGE_BUCKET=tikmi-files

# Scripts: where the 2025 templates and (development only) the real PJP files are.
TIKMI_TEMPLATES_DIR=templates/tikmi/2025
TIKMI_FIXTURES_DIR=../../../TIKMI/Folder PSP
# Password of the development users created by scripts/seed-dev.ts.
TIKMI_DEV_PASSWORD=tikmi-dev-2025
